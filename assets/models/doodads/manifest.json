{
 "generator": "tools/kits/doodads.py",
 "conventions": {
  "units": "metres, Y up, origin at footprint centre on the ground",
  "facing": "front (door, adit, counter, open side) faces -Z like units; the default RtsCamera sits on the +Z side, so spawn neutral buildings with facing = PI for the door-toward-camera look",
  "nodes": "animated parts are child nodes whose origin is the pivot (Godot space, relative to the asset root)",
  "footprint_cells": "footprint [x, z] in 0.5 m cells = the mesh width (bible \u00a71.3: sim footprint and mesh width are the same number); null = walkable decoration. blocks_pathing says whether those cells block (false for the Hale Spring: walkable pool)",
  "vertex_colour": "COLOR_0 RGB on every material (foliage included) = painted AO / base darkening / moss tint, multiplied into the albedo; A = 1. Every mesh starts with a hidden 1 mm dummy triangle, so a plain GLTFDocument import sets vertex_color_use_as_albedo on every material (Godot 4.7 skips a mesh's first primitive); the game loader should still set it explicitly on every material whose meta 'extras'.vc_vertex_color == 'multiply' (all kit materials)",
  "sway_materials": "name contains SWAY: alpha scissor, double sided; sway weight in UV2.x (0 base -> 1 tip), cluster phase in TEXCOORD_2.x (Godot CUSTOM0.x); shader tools/kits/foliage_sway.gdshader adds the wind (a plain import renders them static)",
  "uv2": "x sway weight, y normalized height 0..1 (build_progress reveal: discard where UV2.y > progress)",
  "atlas_materials": "materials with extras.cells_px_per_m are atlases of tiled cells (triangles cut on the repeat lines at export): texel density per cell",
  "emissive": "materials tagged GLOW / LAMP / EMBER / GLYPH are emissive; scale emission energy to pulse",
  "team_colour": "none: neutrals and doodads never carry team colour (art bible \u00a73.1 rule 8)"
 },
