{
  "generator": "tools/kits/buildings.py (procedural bpy kit, no paid generation)",
  "conventions": {
    "units": "metres, Y up (Godot), origin = footprint centre on the ground, door/front faces -Z",
    "footprint": "faction-doc cells x 0.5 m (kingdom.md 7.2, clans.md 7); heights per art bible 1.3 (10-cell column)",
    "materials": "<id> = opaque atlas of tileable swatches (cells 448 px + 32 px wrap padding); <id>_GLOW = windows / embers / smoke-ring glow (emissive, raise emission at night); <id>_TEAM = light grey cloth, UnitView multiplies albedo_color by the player colour. Primitive order GLOW, atlas, TEAM (Godot 4.7's glTF import skips vertex_color_use_as_albedo on a mesh's first primitive; buildings without GLOW start with a hidden 1 mm dummy triangle)",
    "COLOR_0": "RGB = painted AO (ray-cast crevices, ground contact) x top light x per-part tint; A = 1",
    "TEXCOORD_1": "x = build layer (0 frame / lattice / walls, 1 covering: roofs, felt), y = normalized height (0 ground .. 1 top)"
  },
  "build_progress": {
    "approach": "no _construction meshes: a build_progress shader reveals the finished mesh bottom-up from UV2",
    "kingdom": "scaffold-raised: discard where UV2.y > progress (+ a ragged noise band and a glowing edge); scaffold and ladders are particles / a separate shared prop",
    "clans": "Raising, two passes: layer 0 (lattice, masts, stone ring) reveals over progress 0..0.6, layer 1 (felt walls and domes, team bands) over 0.4..1.0",
    "gdshader": "float p = mix(progress / 0.6, (progress - 0.4) / 0.6, step(0.5, UV2.x)); if (UV2.y > clamp(p, 0.0, 1.0) + 0.03 * noise(VERTEX.xz * 4.0)) discard;"
  },
  "team_coverage": "team_coverage_rts = visible TEAM fraction of the silhouette from the 56 deg RTS pitch, front view and mean of 4 yaws (art bible 3.1 asks 6-10 % for buildings; the kit aims at ~8-15 %)",
