; Standalone helper project for the asset tools (tools/render_preview.py).
; Deliberately separate from the game project at the repo root.

config_version=5

[application]

config/name="Vibecraft Asset Preview"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=320
window/size/viewport_height=180

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
