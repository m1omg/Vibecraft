class_name AssetLibrary
extends RefCounted
## Resolves, caches and prepares art assets for the views (visual only, never read by the sim).
## - Model path for a unit/structure def: `def.model` ("units/kingdom_infantry", a res:// path or
##   a bare id), else the unit manifest's alias for the def id, else
##   assets/models/{units,buildings,neutral}/<def_id>.glb, else "" (placeholder).
## - Instancing converts every imported StandardMaterial3D once into the shared painterly
##   ShaderMaterials (unit.gdshader / structure.gdshader / foliage.gdshader), cached per source
##   material, so all instances of a model share materials and per-instance data goes through
##   instance uniforms (unit_uniforms.gdshaderinc).
## - Manifests: assets/models/units/manifest.json (clip timing, stride speed, aliases; generated by
##   src/render/unit_manifest_builder.gd) and assets/models/buildings/manifest.json (footprints).

const UNIT_SHADER := preload("res://src/render/unit.gdshader")
const STRUCTURE_SHADER := preload("res://src/render/structure.gdshader")
const FOLIAGE_SHADER := preload("res://src/render/foliage.gdshader")
const UNIT_MANIFEST := "res://assets/models/units/manifest.json"
const BUILDING_MANIFEST := "res://assets/models/buildings/manifest.json"
const MODEL_DIRS: Array[String] = ["units", "buildings", "neutral", "doodads"]
const EMISSIVE_TAGS: Array[String] = ["GLOW", "LAMP", "EMBER", "GLYPH"]

static var _scenes: Dictionary = {}          ## path -> PackedScene (or null when missing)
static var _materials: Dictionary = {}       ## "kind|instance id of source material|mask" -> Material
static var _model_info: Dictionary = {}      ## path -> {aabb, height, clips}
static var _unit_manifest: Dictionary = {}
static var _building_manifest: Dictionary = {}
static var _manifests_loaded := false
static var _prepared_anims: Dictionary = {}  ## Animation instance id -> true
## Every ShaderMaterial created here, for the per-frame shared uniforms (RenderAtmos).
static var shader_materials: Array[ShaderMaterial] = []


## res:// path of the GLB for a def, or "" when no asset exists (use a placeholder).
static func model_path(def: Dictionary, def_id: String) -> String:
	var model := str(def.get("model", ""))
	if not model.is_empty():
		for p in _candidates(model):
			if ResourceLoader.exists(p):
				return p
	var alias := str(unit_manifest().get("aliases", {}).get(def_id, ""))
	if not alias.is_empty():
		for p in _candidates(alias):
			if ResourceLoader.exists(p):
				return p
	for p in _candidates(def_id):
		if ResourceLoader.exists(p):
			return p
	return ""


static func _candidates(model: String) -> Array[String]:
	if model.begins_with("res://"):
		return [model]
	var out: Array[String] = ["res://assets/models/%s.glb" % model]
	for d in MODEL_DIRS:
		out.append("res://assets/models/%s/%s.glb" % [d, model])
	return out


static func scene(path: String) -> PackedScene:
	if not _scenes.has(path):
		_scenes[path] = load(path) as PackedScene if ResourceLoader.exists(path) else null
	return _scenes[path]


## Manifest entry for a unit model (keyed by the GLB's base name), {} when unknown.
static func unit_entry(path: String) -> Dictionary:
	var units: Dictionary = unit_manifest().get("units", {})
	return units.get(path.get_file().get_basename(), {})


static func building_entry(path: String) -> Dictionary:
	var b: Dictionary = building_manifest().get("buildings", {})
	return b.get(path.get_file().get_basename(), {})


static func unit_manifest() -> Dictionary:
	_load_manifests()
	return _unit_manifest


static func building_manifest() -> Dictionary:
	_load_manifests()
	return _building_manifest


static func _load_manifests() -> void:
	if _manifests_loaded:
		return
	_manifests_loaded = true
	for pair: Array in [[UNIT_MANIFEST, "u"], [BUILDING_MANIFEST, "b"]]:
		if not FileAccess.file_exists(pair[0]):
			continue
		var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(pair[0]))
		if data is Dictionary:
			if pair[1] == "u":
				_unit_manifest = data
			else:
				_building_manifest = data


## Bounds and clip list of a model (computed once per path from a throwaway instance).
static func model_info(path: String) -> Dictionary:
	if _model_info.has(path):
		return _model_info[path]
	var info := {"aabb": AABB(), "height": 0.0, "clips": []}
	var ps := scene(path)
	if ps != null:
		var n := ps.instantiate()
		info["aabb"] = mesh_bounds(n)
		info["height"] = (info["aabb"] as AABB).size.y
		var ap := n.find_child("AnimationPlayer", true, false) as AnimationPlayer
		if ap != null:
			info["clips"] = Array(ap.get_animation_list())
		n.free()
	_model_info[path] = info
	return info


## Union of the mesh AABBs of a node tree, in the root's space (no scene tree needed).
static func mesh_bounds(root: Node) -> AABB:
	var out := AABB()
	var first := true
	for mi: MeshInstance3D in root.find_children("*", "MeshInstance3D", true, false):
		if mi.mesh == null:
			continue
		var xf := Transform3D.IDENTITY
		var c: Node = mi
		while c != null and c != root:
			if c is Node3D:
				xf = (c as Node3D).transform * xf
			c = c.get_parent()
		var b := xf * mi.mesh.get_aabb()
		out = b if first else out.merge(b)
		first = false
	return out


## Instantiates a model with painterly materials. kind: "unit" or "structure".
## `team_mask` (optional) is the per-texel team mask written by process_model (<model>_team.png).
static func instantiate(path: String, kind: String) -> Node3D:
	var ps := scene(path)
	if ps == null:
		return null
	var inst := ps.instantiate() as Node3D
	if inst == null:
		return null
	var mask: Texture2D = null
	var mask_path := path.get_basename() + "_team.png"
	if ResourceLoader.exists(mask_path):
		mask = load(mask_path) as Texture2D
	for mi: MeshInstance3D in inst.find_children("*", "MeshInstance3D", true, false):
		if mi.mesh == null:
			continue
		for s in mi.mesh.get_surface_count():
			var src := mi.mesh.surface_get_material(s)
			var m := convert_material(src, kind, mask)
			if m != null:
				mi.set_surface_override_material(s, m)
	var ap := inst.find_child("AnimationPlayer", true, false) as AnimationPlayer
	if ap != null:
		prepare_animations(ap)
	return inst


## Loop the cyclic clips once per shared Animation resource (idle / walk / work).
static func prepare_animations(ap: AnimationPlayer) -> void:
	for clip in ap.get_animation_list():
		var a := ap.get_animation(clip)
		if a == null or _prepared_anims.has(a.get_instance_id()):
			continue
		_prepared_anims[a.get_instance_id()] = true
		var base := str(clip).to_lower()
		if base in ["idle", "walk", "work", "run"]:
			a.loop_mode = Animation.LOOP_LINEAR
		else:
			a.loop_mode = Animation.LOOP_NONE


static func convert_material(src: Material, kind: String, mask: Texture2D = null) -> Material:
	if src == null or not src is BaseMaterial3D:
		return null
	var key := "%s|%d|%d" % [kind, src.get_instance_id(), mask.get_instance_id() if mask != null else 0]
	if _materials.has(key):
		return _materials[key]
	var sm := src as BaseMaterial3D
	var name := sm.resource_name
	var extras: Dictionary = sm.get_meta("extras", {}) if sm.has_meta("extras") else {}
	var vc_multiply := str(extras.get("vc_vertex_color", "")) == "multiply" or sm.vertex_color_use_as_albedo
	var out: Material
	if name.contains("SWAY"):
		out = foliage_material(sm.albedo_texture, sm.alpha_scissor_threshold if sm.transparency != 0 else 0.5)
	elif name.contains("WATER"):
		var w := sm.duplicate() as StandardMaterial3D
		w.vertex_color_use_as_albedo = vc_multiply
		out = w
	else:
		var m := ShaderMaterial.new()
		m.shader = UNIT_SHADER if kind == "unit" else STRUCTURE_SHADER
		m.set_shader_parameter("albedo_tex", sm.albedo_texture)
		m.set_shader_parameter("vertex_color_multiply", vc_multiply)
		if sm.transparency != BaseMaterial3D.TRANSPARENCY_DISABLED and sm.albedo_texture != null:
			m.set_shader_parameter("alpha_cut", maxf(sm.alpha_scissor_threshold, 0.3))
		# team colour: a texel mask (+ magenta key) when process_model wrote one, else the grey
		# TEAM cloth of the building kit is multiplied by the player colour
		var team_mode := 0
		if mask != null:
			team_mode = 2
			m.set_shader_parameter("team_mask", mask)
		elif name.contains("TEAM"):
			team_mode = 1
		m.set_shader_parameter("team_mode", team_mode)
		if kind == "structure":
			var emissive := false
			for tag in EMISSIVE_TAGS:
				if name.contains(tag):
					emissive = true
			if emissive:
				m.set_shader_parameter("emission_color", sm.emission if sm.emission_enabled else Color(1.0, 0.72, 0.42))
				if sm.emission_texture != null:
					m.set_shader_parameter("emission_tex", sm.emission_texture)
				elif sm.albedo_texture != null:
					m.set_shader_parameter("emission_tex", sm.albedo_texture)
				m.set_shader_parameter("emission_scale", maxf(sm.emission_energy_multiplier, 1.0) * 0.8)
		m.resource_name = name
		shader_materials.append(m)
		out = m
	_materials[key] = out
	return out


static func foliage_material(albedo: Texture2D, cutoff: float = 0.42) -> ShaderMaterial:
	var key := "foliage|%d|%.3f" % [albedo.get_instance_id() if albedo != null else 0, cutoff]
	if _materials.has(key):
		return _materials[key]
	var m := ShaderMaterial.new()
	m.shader = FOLIAGE_SHADER
	m.set_shader_parameter("albedo_tex", albedo)
	m.set_shader_parameter("alpha_cutoff", cutoff)
	m.set_shader_parameter("is_leaves", true)
	shader_materials.append(m)
	_materials[key] = m
	return m


## Sets a shared uniform on every material created here (fx clock, night glow, clouds).
static func set_shared(param: StringName, value: Variant) -> void:
	for m in shader_materials:
		m.set_shader_parameter(param, value)


## Drops all caches (tests).
static func clear_cache() -> void:
	_scenes.clear()
	_materials.clear()
	_model_info.clear()
	_prepared_anims.clear()
	shader_materials.clear()
	_manifests_loaded = false
	_unit_manifest = {}
	_building_manifest = {}
